FROM debian:12

# Install Python, build tools, and curl
RUN apt update -y && apt upgrade -y && \
    apt install -y python3 python3.11-venv python3-pip build-essential curl

# Set the working directory for the server
WORKDIR /server

# Create and use a single virtual environment
RUN python3 -m venv env
ENV PATH="/server/env/bin:$PATH"

# Upgrade pip in the virtual environment
RUN pip install --upgrade pip

# Copy and install dependencies
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN python3 -m spacy download en_core_web_sm

# Copy the entire application, including NeuralNetwork
COPY . .

# Expose the server port
EXPOSE 5000

# Default environment variable for NeuralNetwork script
ENV SCRIPT_NAME=index.py

# Default entry point for the server
ENTRYPOINT ["sh", "-c", "python $SCRIPT_NAME"]

# Instructions for running:
# To run the server:
    # docker run -v /path/to/server/output:/server/output -p 5000:5000 image-name
    # docker run -e SCRIPT_NAME=training/train_spacy_ner.py -v /path/to/host:/server/NeuralNetwork/output_data image-name
# run on mac
    # docker build --platform=linux/amd64 -t grande-server --no-cache .
    # docker run -p 5000:5000 -v /Users/bryan/Desktop/School/Spring2025/Projects/InterviewCoach/interview_coach/server/NeuralNetwork/data:/server/NeuralNetwork/data -v /Users/bryan/Desktop/School/Spring2025/Projects/InterviewCoach/interview_coach/server/NeuralNetwork/models:/server/NeuralNetowrk/models grande-server


