FROM debian:12

RUN apt update -y && apt upgrade -y && \
    apt install -y --no-install-recommends \
    python3 python3.11-venv python3-pip build-essential curl \
    gcc g++ make libc-dev libffi-dev libssl-dev \
    libblas-dev liblapack-dev libatlas-base-dev \
    libxml2-dev libxslt1-dev zlib1g-dev libjpeg-dev libpng-dev \
    libmariadb-dev \
    && apt clean && rm -rf /var/lib/apt/lists/*

# Set the working directory for the server
WORKDIR /server

# Create and activate virtual environment
RUN python3 -m venv env
ENV PATH="/server/env/bin:$PATH"

# Upgrade pip
RUN pip install --upgrade pip

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download spaCy model
RUN python -m spacy download en_core_web_sm

# Copy application files
COPY . .

# Expose port
EXPOSE 5000

# Run the server
ENV SCRIPT_NAME="uvicorn app.main:app --host 0.0.0.0 --port 5000"
ENTRYPOINT ["sh", "-c", "$SCRIPT_NAME"]

# Instructions for running:
# To run the server:
    # docker run -v /path/to/server/output:/server/output -p 5000:5000 image-name
    # docker run -e SCRIPT_NAME=training/train_spacy_ner.py -v /path/to/host:/server/NeuralNetwork/output_data image-name
# run on mac
    # docker build --platform=linux/amd64 -t grande-server --no-cache .
